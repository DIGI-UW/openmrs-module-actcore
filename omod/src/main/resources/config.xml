<!DOCTYPE module PUBLIC "-//OpenMRS//DTD OpenMRS Config 1.0//EN"
  "https://resources.openmrs.org/doctype/config-1.6.dtd">
<module configVersion="1.6">
  <id>rhdflags</id>
  <name>RHD Flags</name>
  <version>${project.parent.version}</version>
  <package>org.openmrs.module.rhdflags</package>
  <author>UW DIGI</author>
  <description>
    Scheduled re-evaluation of every enabled, unretired patient flag, mirrored into patient lists, and a look-up of the data missing behind a flag.
  </description>

  <activator>org.openmrs.module.rhdflags.RhdFlagsActivator</activator>
  <require_version>${openmrsPlatformVersion}</require_version>

  <require_modules>
    <require_module version="${patientflagsVersion}">org.openmrs.module.patientflags</require_module>
    <require_module version="${cohortVersion}">org.openmrs.module.cohort</require_module>
    <require_module version="${webservicesRestVersion}">org.openmrs.module.webservices.rest</require_module>
  </require_modules>

  <!-- Initializer creates the flags while it starts, and this module schedules its first refresh
       when it starts, so it starts after Initializer where Initializer is installed. -->
  <aware_of_modules>
    <aware_of_module>org.openmrs.module.initializer</aware_of_module>
  </aware_of_modules>

  <globalProperty>
    <property>rhdflags.listFlagTag</property>
    <defaultValue></defaultValue>
    <description>
      Only flags carrying this tag are mirrored into a patient list. Leave empty to give every
      enabled flag a list. Useful where some flags are a clinical signal on the chart and are not
      worth a worklist of their own. A list whose flag loses the tag is kept, emptied.
    </description>
  </globalProperty>

  <globalProperty>
    <property>rhdflags.listCohortType</property>
    <defaultValue>System List</defaultValue>
    <description>
      Name of the cohort type given to lists this module creates. The module creates the type if no
      cohort type has this name, and creates no lists while a voided type has it. Lists created
      before this value changes keep their original type.
    </description>
  </globalProperty>
</module>
