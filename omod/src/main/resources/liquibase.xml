<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-2.0.xsd">

  <changeSet id="actcore-2026-09-29-prophylaxis-adherence" author="UW DIGI">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="actcore_prophylaxis_adherence"/></not>
    </preConditions>
    <comment>Each patient's prophylaxis adherence and next due date, as the adherence refresh last computed them</comment>
    <createTable tableName="actcore_prophylaxis_adherence">
      <column name="patient_id" type="int">
        <constraints primaryKey="true" nullable="false"
            foreignKeyName="actcore_prophylaxis_adherence_patient" references="patient(patient_id)"/>
      </column>
      <column name="regimen_concept_id" type="int">
        <constraints foreignKeyName="actcore_prophylaxis_adherence_regimen" references="concept(concept_id)"/>
      </column>
      <column name="injection_interval_days" type="int"/>
      <column name="adherence" type="double"/>
      <column name="last_given" type="date"/>
      <column name="next_due" type="date"/>
      <column name="date_computed" type="datetime">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>
  <changeSet id="actcore-2026-10-07-injection-timing" author="UW DIGI">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="actcore_injection_timing"/></not>
    </preConditions>
    <comment>Each BPG injection given while a course was in force, and whether it was on time, as the adherence refresh last timed it</comment>
    <createTable tableName="actcore_injection_timing">
      <column name="patient_id" type="int">
        <constraints primaryKey="true" nullable="false"
            foreignKeyName="actcore_injection_timing_patient" references="patient(patient_id)"/>
      </column>
      <column name="injection_date" type="date">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="on_time" type="boolean">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <createIndex tableName="actcore_injection_timing" indexName="actcore_injection_timing_date">
      <column name="injection_date"/>
    </createIndex>
  </changeSet>
  <changeSet id="actcore-2026-10-13-next-steps-patient-information" author="UW DIGI">
    <comment>Adds the Patient Information step's encounter type to actcore.nextSteps.encounterTypes where it still holds the earlier default</comment>
    <update tableName="global_property">
      <column name="property_value" value="bpg:04cf03db-3b8e-5020-84b0-50b06338767a,oral:55271793-ef37-58da-9d86-1d9092a5a809,consult:c2503561-c00d-5460-8157-43d594472b4a,echo:730f5ec2-7102-55d0-8602-2d792844f245,procedures:c9b87090-8768-50be-987e-8ca0a8983429,inr:b4bb88a3-9a04-5142-85bd-bb63c270f632,patientInfo:ffdc883f-f99f-496a-83f9-2c3c581e1af0"/>
      <where>property = 'actcore.nextSteps.encounterTypes' AND property_value = 'bpg:04cf03db-3b8e-5020-84b0-50b06338767a,oral:55271793-ef37-58da-9d86-1d9092a5a809,consult:c2503561-c00d-5460-8157-43d594472b4a,echo:730f5ec2-7102-55d0-8602-2d792844f245,procedures:c9b87090-8768-50be-987e-8ca0a8983429,inr:b4bb88a3-9a04-5142-85bd-bb63c270f632'</where>
    </update>
  </changeSet>
  <changeSet id="actcore-2026-10-20-download-log" author="UW DIGI">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="actcore_download_log"/></not>
    </preConditions>
    <comment>Each download of forms' fields: who, when, the form and what it held</comment>
    <createTable tableName="actcore_download_log">
      <column name="download_id" type="int" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="user_id" type="int">
        <constraints nullable="false" foreignKeyName="actcore_download_log_user" references="users(user_id)"/>
      </column>
      <!-- No foreign key to the form, so purging it keeps the downloads that name it. -->
      <column name="form_id" type="int"/>
      <column name="detail" type="text"/>
      <column name="date_created" type="datetime">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <createIndex tableName="actcore_download_log" indexName="actcore_download_log_date">
      <column name="date_created"/>
    </createIndex>
  </changeSet>
</databaseChangeLog>
