<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-2.0.xsd">

  <changeSet id="actcore-2026-09-29-prophylaxis-adherence" author="UW DIGI">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="actcore_prophylaxis_adherence"/></not>
    </preConditions>
    <comment>Each patient's prophylaxis adherence and next due date, as the adherence refresh last computed them</comment>
    <createTable tableName="actcore_prophylaxis_adherence">
      <column name="patient_id" type="int">
        <constraints primaryKey="true" nullable="false"
            foreignKeyName="actcore_prophylaxis_adherence_patient" references="patient(patient_id)"/>
      </column>
      <column name="regimen_concept_id" type="int">
        <constraints foreignKeyName="actcore_prophylaxis_adherence_regimen" references="concept(concept_id)"/>
      </column>
      <column name="injection_interval_days" type="int"/>
      <column name="adherence" type="double"/>
      <column name="last_given" type="date"/>
      <column name="next_due" type="date"/>
      <column name="date_computed" type="datetime">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>
  <changeSet id="actcore-2026-10-07-injection-timing" author="UW DIGI">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="actcore_injection_timing"/></not>
    </preConditions>
    <comment>Each BPG injection given while a course was in force, and whether it was on time, as the adherence refresh last timed it</comment>
    <createTable tableName="actcore_injection_timing">
      <column name="patient_id" type="int">
        <constraints primaryKey="true" nullable="false"
            foreignKeyName="actcore_injection_timing_patient" references="patient(patient_id)"/>
      </column>
      <column name="injection_date" type="date">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="on_time" type="boolean">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <createIndex tableName="actcore_injection_timing" indexName="actcore_injection_timing_date">
      <column name="injection_date"/>
    </createIndex>
  </changeSet>
  <changeSet id="actcore-2026-10-13-next-steps-patient-information" author="UW DIGI">
    <comment>Adds the Patient Information step's encounter type to actcore.nextSteps.encounterTypes where it still holds the earlier default</comment>
    <update tableName="global_property">
      <column name="property_value" value="bpg:04cf03db-3b8e-5020-84b0-50b06338767a,oral:55271793-ef37-58da-9d86-1d9092a5a809,consult:c2503561-c00d-5460-8157-43d594472b4a,echo:730f5ec2-7102-55d0-8602-2d792844f245,procedures:c9b87090-8768-50be-987e-8ca0a8983429,inr:b4bb88a3-9a04-5142-85bd-bb63c270f632,patientInfo:ffdc883f-f99f-496a-83f9-2c3c581e1af0"/>
      <where>property = 'actcore.nextSteps.encounterTypes' AND property_value = 'bpg:04cf03db-3b8e-5020-84b0-50b06338767a,oral:55271793-ef37-58da-9d86-1d9092a5a809,consult:c2503561-c00d-5460-8157-43d594472b4a,echo:730f5ec2-7102-55d0-8602-2d792844f245,procedures:c9b87090-8768-50be-987e-8ca0a8983429,inr:b4bb88a3-9a04-5142-85bd-bb63c270f632'</where>
    </update>
  </changeSet>
  <changeSet id="actcore-2026-10-20-download-log" author="UW DIGI">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="actcore_download_log"/></not>
    </preConditions>
    <comment>Each download of forms' fields: who, when, the form and what it held</comment>
    <createTable tableName="actcore_download_log">
      <column name="download_id" type="int" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="user_id" type="int">
        <constraints nullable="false" foreignKeyName="actcore_download_log_user" references="users(user_id)"/>
      </column>
      <!-- No foreign key to the form, so purging it keeps the downloads that name it. -->
      <column name="form_id" type="int"/>
      <column name="detail" type="text"/>
      <column name="date_created" type="datetime">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <createIndex tableName="actcore_download_log" indexName="actcore_download_log_date">
      <column name="date_created"/>
    </createIndex>
  </changeSet>
  <changeSet id="actcore-2026-10-20-raised-flag" author="UW DIGI">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="actcore_raised_flag"/></not>
    </preConditions>
    <comment>Each patient's flag that ACT Core's evaluation finds raised, since when, and who dismissed it</comment>
    <createTable tableName="actcore_raised_flag">
      <column name="patient_id" type="int">
        <constraints primaryKey="true" nullable="false"
            foreignKeyName="actcore_raised_flag_patient" references="patient(patient_id)"/>
      </column>
      <column name="flag_id" type="int">
        <constraints primaryKey="true" nullable="false" deleteCascade="true"
            foreignKeyName="actcore_raised_flag_flag" references="patientflags_flag(flag_id)"/>
      </column>
      <column name="raised_since" type="datetime">
        <constraints nullable="false"/>
      </column>
      <column name="dismissed_by" type="int">
        <constraints foreignKeyName="actcore_raised_flag_dismissed_by" references="users(user_id)"/>
      </column>
      <column name="date_dismissed" type="datetime"/>
    </createTable>
    <createIndex tableName="actcore_raised_flag" indexName="actcore_raised_flag_flag">
      <column name="flag_id"/>
    </createIndex>
  </changeSet>
  <changeSet id="actcore-2026-10-20-raised-flag-seed" author="UW DIGI">
    <comment>Dates each flag raised now from the patient's time on its list, else from its oldest row</comment>
    <sql>
      INSERT INTO actcore_raised_flag (patient_id, flag_id, raised_since)
      SELECT pf.patient_id, pf.flag_id, COALESCE(
          (SELECT MIN(cm.start_date) FROM cohort_member cm
           JOIN cohort c ON c.cohort_id = cm.cohort_id AND c.voided = 0
           JOIN patientflags_flag f ON f.uuid = c.uuid
           WHERE f.flag_id = pf.flag_id AND cm.patient_id = pf.patient_id AND cm.voided = 0 AND cm.end_date IS NULL),
          MIN(pf.date_created), CURRENT_TIMESTAMP)
      FROM patientflags_patient_flag pf
      WHERE pf.voided = 0
      GROUP BY pf.patient_id, pf.flag_id
    </sql>
  </changeSet>
  <changeSet id="actcore-2026-10-22-flag-dismissal" author="UW DIGI">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="actcore_flag_dismissal"/></not>
    </preConditions>
    <comment>Each dismissal of a patient's flag, kept once the flag lowers, from the dismissals recorded so far</comment>
    <createTable tableName="actcore_flag_dismissal">
      <column name="dismissal_id" type="int" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="patient_id" type="int">
        <constraints nullable="false" foreignKeyName="actcore_flag_dismissal_patient" references="patient(patient_id)"/>
      </column>
      <!-- No foreign key to the flag, so deleting it keeps the dismissals that name it. -->
      <column name="flag_id" type="int">
        <constraints nullable="false"/>
      </column>
      <column name="dismissed_by" type="int">
        <constraints foreignKeyName="actcore_flag_dismissal_dismissed_by" references="users(user_id)"/>
      </column>
      <column name="date_dismissed" type="datetime">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <createIndex tableName="actcore_flag_dismissal" indexName="actcore_flag_dismissal_date">
      <column name="date_dismissed"/>
    </createIndex>
    <sql>
      INSERT INTO actcore_flag_dismissal (patient_id, flag_id, dismissed_by, date_dismissed)
      SELECT patient_id, flag_id, dismissed_by, date_dismissed FROM actcore_raised_flag
      WHERE date_dismissed IS NOT NULL
      ORDER BY date_dismissed
    </sql>
  </changeSet>
  <changeSet id="actcore-2026-10-26-run-chart-record" author="UW DIGI">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="actcore_run_chart_record"/></not>
    </preConditions>
    <comment>Each day's run chart metrics per clinic, and with no location for every clinic, as ACT 2.0's runchart_record</comment>
    <createTable tableName="actcore_run_chart_record">
      <column name="record_id" type="int" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="record_date" type="date">
        <constraints nullable="false"/>
      </column>
      <column name="location_id" type="int">
        <constraints foreignKeyName="actcore_run_chart_record_location" references="location(location_id)" deleteCascade="true"/>
      </column>
      <column name="total_registrants" type="int" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="active_registrants" type="int" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="active_registrants_seen_last_7_months" type="int" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="active_registrants_prescribed_prophylaxis" type="int" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="active_registrants_adherent" type="int" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="consultation_visit_total" type="int" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="consultation_visits_with_echocardiogram_resulted" type="int" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="consultation_visits_with_intervention" type="int" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="interventions_completed" type="int" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="date_created" type="datetime">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <!-- MySQL treats the null location of the every-clinic row as distinct, so only the replace protects it. -->
    <createIndex tableName="actcore_run_chart_record" indexName="actcore_run_chart_record_date_location" unique="true">
      <column name="record_date"/>
      <column name="location_id"/>
    </createIndex>
    <createIndex tableName="actcore_run_chart_record" indexName="actcore_run_chart_record_date">
      <column name="record_date"/>
    </createIndex>
    <createIndex tableName="actcore_run_chart_record" indexName="actcore_run_chart_record_location_date">
      <column name="location_id"/>
      <column name="record_date"/>
    </createIndex>
  </changeSet>
  <changeSet id="actcore-2026-10-26-run-chart-run" author="UW DIGI">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="actcore_run_chart_run"/></not>
    </preConditions>
    <comment>Each run of the run chart snapshot, taken or failed with its reason, so a failed night can be told from a missing one</comment>
    <createTable tableName="actcore_run_chart_run">
      <column name="run_id" type="int" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="run_date" type="date">
        <constraints nullable="false"/>
      </column>
      <column name="finished" type="datetime">
        <constraints nullable="false"/>
      </column>
      <column name="duration_millis" type="bigint" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="source" type="varchar(16)">
        <constraints nullable="false"/>
      </column>
      <column name="status" type="varchar(16)">
        <constraints nullable="false"/>
      </column>
      <column name="row_count" type="int" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="clinic_count" type="int" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="failure_reason" type="varchar(500)"/>
    </createTable>
    <createIndex tableName="actcore_run_chart_run" indexName="actcore_run_chart_run_finished">
      <column name="finished"/>
    </createIndex>
  </changeSet>
  <changeSet id="actcore-2026-10-27-screening-count" author="UW DIGI">
