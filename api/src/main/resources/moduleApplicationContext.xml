<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
		http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">

    <!-- Core's session factory chains every Interceptor bean: checks a site administrator's change to a
         user's clinics or roles as it is written, against the values still in the database -->
    <bean id="actcoreUserClinicsFlushCheck" class="org.openmrs.module.actcore.clinics.UserClinicsFlushCheck"/>

    <bean id="actcore.ScreeningCountService" class="org.springframework.transaction.interceptor.TransactionProxyFactoryBean">
        <property name="transactionManager" ref="transactionManager"/>
        <property name="target">
            <bean class="org.openmrs.module.actcore.api.impl.ScreeningCountServiceImpl">
                <property name="dao">
                    <bean class="org.openmrs.module.actcore.api.db.hibernate.HibernateScreeningCountDAO">
                        <property name="sessionFactory" ref="dbSessionFactory"/>
                    </bean>
                </property>
            </bean>
        </property>
        <property name="preInterceptors" ref="serviceInterceptors"/>
        <property name="transactionAttributeSource" ref="transactionAttributeSource"/>
    </bean>
    <bean parent="serviceContext">
        <property name="moduleService">
            <list>
                <value>org.openmrs.module.actcore.api.ScreeningCountService</value>
                <ref bean="actcore.ScreeningCountService"/>
            </list>
        </property>
    </bean>

    <bean id="actcore.DownloadLogService" class="org.springframework.transaction.interceptor.TransactionProxyFactoryBean">
        <property name="transactionManager" ref="transactionManager"/>
        <property name="target">
            <bean class="org.openmrs.module.actcore.api.impl.DownloadLogServiceImpl">
                <property name="dao">
                    <bean class="org.openmrs.module.actcore.api.db.hibernate.HibernateDownloadLogDAO">
                        <property name="sessionFactory" ref="dbSessionFactory"/>
                    </bean>
                </property>
            </bean>
        </property>
        <property name="preInterceptors" ref="serviceInterceptors"/>
        <property name="transactionAttributeSource" ref="transactionAttributeSource"/>
    </bean>
    <bean parent="serviceContext">
        <property name="moduleService">
            <list>
                <value>org.openmrs.module.actcore.api.DownloadLogService</value>
                <ref bean="actcore.DownloadLogService"/>
            </list>
        </property>
    </bean>

    <!-- A bean of its own, as the flag refresh and the flag lists look it up to read the flag rows and cohorts -->
    <bean id="actcoreRaisedFlagDAO" class="org.openmrs.module.actcore.api.db.hibernate.HibernateRaisedFlagDAO">
        <property name="sessionFactory" ref="dbSessionFactory"/>
    </bean>

