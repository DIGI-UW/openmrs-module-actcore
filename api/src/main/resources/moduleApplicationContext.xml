    </bean>
    <bean parent="serviceContext">
        <property name="moduleService">
            <list>
                <value>org.openmrs.module.actcore.api.NextStepsService</value>
                <ref bean="actcore.NextStepsService"/>
            </list>
        </property>
    </bean>
</beans>
