                <value>org.openmrs.module.actcore.api.RaisedFlagService</value>
                <ref bean="actcore.RaisedFlagService"/>
            </list>
        </property>
    </bean>

    <bean id="actcore.StudyService" class="org.springframework.transaction.interceptor.TransactionProxyFactoryBean">
        <property name="transactionManager" ref="transactionManager"/>
        <property name="target">
            <bean class="org.openmrs.module.actcore.api.impl.StudyServiceImpl">
                <property name="dao">
                    <bean class="org.openmrs.module.actcore.api.db.hibernate.HibernateStudyDAO">
                        <property name="sessionFactory" ref="dbSessionFactory"/>
                    </bean>
                </property>
            </bean>
        </property>
        <property name="preInterceptors" ref="serviceInterceptors"/>
