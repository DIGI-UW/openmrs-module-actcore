    </bean>

    <bean id="actcore.FlagGapService" class="org.springframework.transaction.interceptor.TransactionProxyFactoryBean">
        <property name="transactionManager" ref="transactionManager"/>
        <property name="target">
            <bean class="org.openmrs.module.actcore.api.impl.FlagGapServiceImpl">
                <property name="dao">
                    <bean class="org.openmrs.module.actcore.api.db.hibernate.HibernateFlagGapDAO">
