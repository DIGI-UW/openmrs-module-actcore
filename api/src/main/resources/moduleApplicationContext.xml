    <bean id="actcore.AuditLogService" class="org.springframework.transaction.interceptor.TransactionProxyFactoryBean">
        <property name="transactionManager" ref="transactionManager"/>
        <property name="target">
            <bean class="org.openmrs.module.actcore.api.impl.AuditLogServiceImpl">
                <property name="dao">
                    <bean class="org.openmrs.module.actcore.api.db.hibernate.HibernateAuditLogDAO">
