    <bean parent="serviceContext">
        <property name="moduleService">
            <list>
                <value>org.openmrs.module.actcore.api.StudyService</value>
                <ref bean="actcore.StudyService"/>
            </list>
        </property>
    </bean>
    <!-- Looked up by the registry's advice and start-up work, which no service wraps -->
    <bean id="actcoreRegistryDAO" class="org.openmrs.module.actcore.api.db.hibernate.HibernateRegistryDAO">
        <property name="sessionFactory" ref="dbSessionFactory"/>
    </bean>

    <!-- A bean of its own, as UserClinicsFlushCheck looks it up to read without starting a transaction mid-flush -->
    <bean id="actcoreUserClinicsDAO" class="org.openmrs.module.actcore.api.db.hibernate.HibernateUserClinicsDAO">
        <property name="sessionFactory" ref="dbSessionFactory"/>
    </bean>

